PORT=5000
# Must be a replica set (MongoDB Atlas works) because confirmation uses a transaction
MONGO_URI=mongodb+srv://user:pass@cluster.mongodb.net/event
# Local alternative (after creating the replica set described in README.md):
# MONGO_URI=mongodb://127.0.0.1:27040/larper_or_coder?replicaSet=locDev
CLIENT_ORIGIN=http://localhost:5173

RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxx

# Per-person fee in rupees; a team of 2 pays 2x this
FEE_PER_PERSON_INR=149

# Maximum number of confirmed teams
MAX_TEAMS=30
# Minutes a pending registration holds a seat while its owner is in Razorpay Checkout
HOLD_MINUTES=15
